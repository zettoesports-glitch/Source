// Generated from vulkan-main/vulkan-main/Shaders/models/color.ps.
// The material sampler is intentionally absent after optimization because this
// pass outputs vertex/instance color directly.

struct ColorPixelInput
{
    highp vec4 Position;
    highp vec4 Color;
    highp float MinAlpha;
};

layout(location = 0) in highp vec4 input_Color;
layout(location = 1) flat in highp float input_MinAlpha;
layout(location = 0) out highp vec4 _entryPointOutput;

highp vec4 _main(ColorPixelInput _input)
{
    if ((_input.Color.w - _input.MinAlpha) < 0.0)
        discard;

    return _input.Color;
}

void main()
{
    ColorPixelInput _input;
    _input.Position = gl_FragCoord;
    _input.Color = input_Color;
    _input.MinAlpha = input_MinAlpha;
    _entryPointOutput = _main(_input);
}
